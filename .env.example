# Copy to .env.local for local development. Never commit real credentials.
APP_URL=http://localhost:3000
# Stripe test-mode secret key, beginning with sk_test_
STRIPE_SECRET_KEY=
# A fixed Stripe Price ID (price_...), not a client-supplied amount
STRIPE_PRICE_ID=
# Set this from Stripe's webhook endpoint configuration
STRIPE_WEBHOOK_SECRET=
# Generate a long random value; required to access simulation operations
ADMIN_API_TOKEN=
